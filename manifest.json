{
  "manifest_version": 3,
  "name": "VoxSift",
  "version": "0.1.0",
  "description": "Hear the page, not the noise. Smart content extraction and text-to-speech for any webpage.",
  "minimum_chrome_version": "120",

  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },

  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "32": "public/icons/icon-32.png"
    }
  },

  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "tts",
    "activeTab",
    "scripting",
    "offscreen",
    "alarms",
    "tabs"
  ],

  "host_permissions": ["<all_urls>"],

  "web_accessible_resources": [
    {
      "resources": ["src/offscreen/index.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "activate-reading": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Read selected text, or read the page if nothing is selected"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
